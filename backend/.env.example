# Model Configuration
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
BERT_MODEL=bert-base-uncased
DEVICE=cuda  # or cpu

# Scoring Thresholds
MATCH_THRESHOLD=0.7
HIGH_MATCH_THRESHOLD=0.85
LOW_MATCH_THRESHOLD=0.5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security Configuration
# API Keys - comma-separated list of valid API keys
# Generate secure keys using: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=your-secret-api-key-here,another-api-key-here
REQUIRE_API_KEY=true

# CORS Settings - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# File Upload Limits
MAX_FILE_SIZE_MB=5
MAX_TEXT_LENGTH=50000
MAX_BATCH_SIZE=10
MAX_REQUEST_SIZE_MB=10

